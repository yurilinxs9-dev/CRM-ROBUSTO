# ============================================================
# CRM WhatsApp — Environment Variables
# Copie para .env e preencha com seus valores reais
# NUNCA commite o .env com credenciais reais
# ============================================================

# VPS
VPS_IP=000.000.000.000
VPS_USER=root

# Supabase (Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Redis. Default: in-cluster container `crm-redis` (via docker-compose.yml).
# For local dev outside compose: redis://localhost:6379
# For TLS-managed Redis (Upstash, ElastiCache, etc): rediss://USER:PASS@HOST:PORT
REDIS_URL=redis://crm-redis:6379

# JWT — gere com: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Webhook
WEBHOOK_SECRET=your_webhook_secret

# App
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-app.vercel.app
SUPABASE_STORAGE_BUCKET=crm-media
FFMPEG_PATH=/usr/bin/ffmpeg

# Audio PTT (Phase 1)
# UAZAPI_PTT_FIELD: 'ptt' (default, sends type:ptt) | 'audio+ptt' (legacy fallback, sends type:audio + ptt:true)
UAZAPI_PTT_FIELD=ptt
# AUDIO_SEND_STRATEGY: 'auto' (try signed URL first, fallback to base64) | 'url' (always signed URL) | 'base64' (always data URI)
AUDIO_SEND_STRATEGY=auto
# Optional: explicit ffprobe binary path (defaults to system ffprobe)
# FFPROBE_PATH=/usr/bin/ffprobe

# IA nativa — chave p/ cifrar (AES-256-GCM) as API keys de IA em repouso.
# Gere com: openssl rand -base64 32. Trocar invalida as chaves já cadastradas.
AI_ENCRYPTION_KEY=your_ai_encryption_secret_min_32_chars

# IA nativa — whitelist de hosts permitidos em AiModelConfig.base_url (POST/PUT
# /ai/models). Protege contra exfiltração: um admin de plataforma com escopo
# `ai` (mas não '*') não pode apontar um modelo pra um endpoint próprio, já que
# modelos são globais e os prompts de copilot/suggest-reply/follow-up leem
# conversas de qualquer tenant. Hosts separados por vírgula; se definida,
# SUBSTITUI a whitelist padrão (api.anthropic.com, api.openai.com,
# openrouter.ai, api.groq.com, api.deepseek.com, api.mistral.ai, api.x.ai,
# api.together.xyz, generativelanguage.googleapis.com) — vale até para o admin
# master. Deixe vazio/ausente para usar a whitelist padrão.
# AI_ALLOWED_HOSTS=api.anthropic.com,api.openai.com

# Hosts internos da rede docker autorizados a usar http para LLM local (ex.:
# Ollama). Csv; vazia/ausente mantem o padrao (`ollama`). Todo host externo
# continua exigindo https.
# AI_ALLOWED_INTERNAL_HOSTS=ollama

# Logging
LOG_LEVEL=debug

# Sentry (Phase 3) — leave SENTRY_DSN empty to disable observability
SENTRY_DSN=
SENTRY_ENV=production
# SENTRY_RELEASE=crm-api@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Meta Lead Ads import: empty = disabled.
SHEET_IMPORT_TENANT_ID=
SHEET_IMPORT_SHEET_ID=
SHEET_IMPORT_GID=
SHEET_IMPORT_PIPELINE_ID=
SHEET_IMPORT_STAGE_ID=

# WhatsApp Cloud API (Meta, API oficial) — modules/webhooks, rota /api/webhook/meta
#
# META_VERIFY_TOKEN: string que VOCE inventa e digita nos dois lugares — aqui e
# no campo "Verify token" do webhook no painel da Meta. Ela so e usada no
# handshake GET de configuracao; nao e segredo da Meta, mas quem souber o valor
# consegue apontar o proprio App para esta URL. Gere com: openssl rand -hex 32
# META_VERIFY_TOKEN=
#
# META_APP_SECRET: App Secret do app da Meta (Configuracoes > Basico). Assina
# cada POST em X-Hub-Signature-256; sem ele o endpoint recusa TODO evento, ja
# que a rota e publica. Nunca versionar.
# META_APP_SECRET=
# Transactional email (server only). Never expose this key in NEXT_PUBLIC_*.
RESEND_API_KEY=
EMAIL_FROM="CRM PRO <noreply@email.crmpro.uk>"
