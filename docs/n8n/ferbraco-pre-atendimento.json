      "name": "Webhook CRM",
      "webhookId": "d93e231e-7e23-4ae0-9b90-878561309185"
    },
    {
      "parameters": {
        "jsCode": "// ======= CONFIGURAÇÃO DO PRÉ-ATENDIMENTO FERBRAÇO (edite aqui) =======\nconst CFG = {\n  crmApi: 'https://api.crmpro.uk/api/v1',\n  // Servidor Evolution (mesmo EVOLUTION_BASE_URL do backend do CRM), sem barra no fim.\n  evolutionUrl: 'https://TROCAR-URL-DA-EVOLUTION',\n  instanciaPrincipal: 'thiago-henrique-gestor-comercial',\n  // Dono do número principal: lead novo chega nele com este responsável.\n  thiagoId: 'a791b088-c14b-4f46-b793-f61126ec36d2',\n  setores: {\n    balcao: '2b7949a6-d4c5-4ddf-a827-8183c29a389f', // vendas balcao ferbraco (rodízio)\n    pompeu: '07c6f18a-eb7f-4816-bf47-b7500491c8fd', // regiao pompeu e abaete\n    sul: 'ab90ed27-bd1d-40b8-9f55-9b13a4faaf55',    // regiao sul de minas\n  },\n  // WhatsApp de cada vendedor (DDI+DDD+número, só dígitos) para o aviso.\n  // Vazio = não avisa aquele vendedor pelo WhatsApp (o CRM avisa no app).\n  vendedores: {\n    '0a02bfee-6367-445f-903d-d7bff820fb0a': { nome: 'Yago', whatsapp: '' },\n    'c6cf6fcd-4ca3-49d2-9d0a-a02fc506e140': { nome: 'Bruno', whatsapp: '' },\n    '3b9961c9-4cb1-4f6b-addf-1b2cbadf8f6b': { nome: 'Giordane', whatsapp: '' },\n    'e5a9b008-fb95-44e6-8d60-1517808bd916': { nome: 'Leo', whatsapp: '' },\n    '06360642-cc21-436b-8177-8a24457cd8e0': { nome: 'Marcio', whatsapp: '' },\n    '4ca64ae8-f39b-4013-a8bf-d988011a0651': { nome: 'Pedro', whatsapp: '' },\n    '69deb20e-7e1e-4393-9c46-bf9f9e46b75d': { nome: 'Fabio', whatsapp: '' },\n    '42bcf9f1-a245-46f2-a27f-5462db228782': { nome: 'Adriano', whatsapp: '' },\n  },\n  // Lead que já existia há mais que isso quando escreveu = cliente antigo do\n  // Thiago, não passa pela triagem.\n  leadNovoMinutos: 15,\n  boasVindas: [\n    '👋 Olá! Seja bem-vindo(a) à *FERBRAÇO!* 💚🤍',\n    '',\n    '🏗️ A casa do construtor e do amigo serralheiro!',\n    '',\n    'Obrigado por entrar em contato conosco! Será um prazer ajudar você a encontrar os materiais ideais para sua obra ou projeto.',\n    '',\n    'Para agilizar seu atendimento, me informe, por gentileza:',\n    '',\n    '👤 *Qual é o seu nome?*',\n    '📍 *De qual cidade você está falando?*',\n    '📋 *Quais materiais você precisa?*',\n    '',\n    'Pode enviar sua lista de materiais por texto ou foto, que nossa equipe vai preparar seu atendimento com toda atenção!',\n    '',\n    '🚀 Estamos prontos para ajudar você a tirar seu projeto do papel!',\n    '',\n    '*FERBRAÇO — Qualidade, confiança e parceria com você!* 💚🤍',\n  ].join('\\n'),\n  perguntaCidade: 'Para eu te direcionar ao vendedor certo, me conta: *de qual cidade você está falando?* 📍',\n  direcionando: 'Obrigado! ✅ Em breve você será atendido por um de nossos vendedores. 💚',\n};\n// ======================================================================\n\nconst body = $json.body ?? {};\nconst data = body.data ?? {};\nconst msg = data.message ?? {};\nconst contato = data.contact ?? {};\nreturn [{\n  json: {\n    cfg: CFG,\n    evento: body.event_type ?? '',\n    leadId: contato.id ?? '',\n    telefone: String(contato.phone ?? '').replace(/\\D/g, ''),\n    nomeContato: contato.name ?? '',\n    direcao: msg.direction ?? '',\n    tipo: String(msg.type ?? '').toUpperCase(),\n    texto: (msg.text ?? '').trim(),\n    midia: msg.media?.url ?? null,\n    responsavel: data.metadata?.assigned_user ?? null,\n    agora: String(Date.now()),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
