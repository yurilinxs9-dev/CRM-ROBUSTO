      "parameters": {
        "jsCode": "const d = $('Dados da mensagem').first().json;\nconst decisao = $('Monta direcionamento').first().json;\nconst resp = $('Move para o setor (rodízio)').first().json.responsavel_id;\nconst vendedor = d.cfg.vendedores[resp];\nif (!vendedor || !vendedor.whatsapp) return [];\nconst texto = [\n  '🎯 *Novo cliente para você* (pré-atendimento)',\n  '',\n  '👤 *Nome:* ' + (decisao.nome || d.nomeContato || '-'),\n  '📍 *Cidade:* ' + (decisao.cidade || 'não informada'),\n  '📋 *Precisa de:* ' + (decisao.materiais || 'não informado'),\n  '📱 *WhatsApp:* https://wa.me/' + d.telefone,\n  '',\n  'Ele já está no seu CRM. Chame o cliente pelo seu número. 💚',\n].join('\\n');\nreturn [{ json: { numero: vendedor.whatsapp.replace(/\\D/g, ''), texto } }];"
